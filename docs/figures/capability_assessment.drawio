  <diagram name="Final airline capability labels" id="source_review">
    <mxGraphModel dx="1000" dy="1300" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1000" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="generate" value="&lt;b&gt;1. Generate synthetic airline questions&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fictional booking, policy, support and refund records" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0E9FC;strokeColor=#8256A7;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="80.0" y="43.0" width="840" height="114.0" as="geometry" />
        </mxCell>
        <mxCell id="execute" value="&lt;b&gt;2. Execute with the unchanged local LFM model&lt;/b&gt;&lt;br&gt;&lt;br&gt;Save the request, tool calls, returned records, answer and termination status" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DDF3EE;strokeColor=#268A7F;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="80.0" y="205.0" width="840" height="114.0" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;3. Review local capability against the source&lt;/b&gt;&lt;br&gt;&lt;br&gt;Automated review agents check completeness, facts, policy application and calculations&lt;br&gt;Native grades are retained as separate diagnostic evidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF0DA;strokeColor=#C28832;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="80.0" y="370.0" width="840" height="138.0" as="geometry" />
        </mxCell>
        <mxCell id="pass" value="&lt;b&gt;Supported success&lt;/b&gt;&lt;br&gt;&lt;br&gt;LOCAL&lt;br&gt;Unless the request or&lt;br&gt;capability constraint&lt;br&gt;requires escalation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E4F3DF;strokeColor=#4C8B42;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="81.5" y="563.5" width="261.0" height="159.0" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="&lt;b&gt;Local failure&lt;/b&gt;&lt;br&gt;&lt;br&gt;ESCALATE&lt;br&gt;The remote result&lt;br&gt;does not change&lt;br&gt;this target" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FBE5E4;strokeColor=#B9615B;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="369.5" y="563.5" width="261.0" height="159.0" as="geometry" />
        </mxCell>
        <mxCell id="unknown" value="&lt;b&gt;Unresolved&lt;/b&gt;&lt;br&gt;&lt;br&gt;Preserve the record&lt;br&gt;Exclude from&lt;br&gt;resolved labels" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EFF1F5;strokeColor=#8793A5;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="657.5" y="563.5" width="261.0" height="159.0" as="geometry" />
        </mxCell>
        <mxCell id="dataset" value="&lt;b&gt;4. Form the final decision-training dataset&lt;/b&gt;&lt;br&gt;&lt;br&gt;1,020 contexts: 558 LOCAL and 462 ESCALATE&lt;br&gt;Input: pre-execution request and tool interface&lt;br&gt;Target: the reviewed decision label" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E5EFFB;strokeColor=#4379AE;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
