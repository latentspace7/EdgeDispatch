        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Label policy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Explicit escalation requests set ESCALATE directly&lt;br&gt;Unresolved cases have no training label" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EFF1F5;strokeColor=#8793A5;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
