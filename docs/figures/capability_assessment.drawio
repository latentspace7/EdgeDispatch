<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram name="Initial paired capability study" id="capability_study">
    <mxGraphModel dx="1000" dy="1300" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1000" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="generate" value="&lt;b&gt;1. Generate synthetic task bundles&lt;/b&gt;&lt;br&gt;&lt;br&gt;Qwen3.8-max: 12 capabilities across 12 business domains&lt;br&gt;Request, tools, initial records, documents and expected outcome" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0E9FC;strokeColor=#8256A7;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="80.0" y="38.50000000000001" width="840" height="122.99999999999999" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="&lt;b&gt;2. Check the source and prepare the MCP world&lt;/b&gt;&lt;br&gt;&lt;br&gt;Schema validation, source review and independently reset state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E5EFFB;strokeColor=#4379AE;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="80.0" y="227.5" width="840" height="99.0" as="geometry" />
        </mxCell>
        <mxCell id="lfm" value="&lt;b&gt;3a. Execute with LFM2.5-2.6B&lt;/b&gt;&lt;br&gt;&lt;br&gt;Local executor, Q8_0&lt;br&gt;Save tool calls, results, answer&lt;br&gt;and final world state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DDF3EE;strokeColor=#268A7F;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="81.5" y="376.0" width="399.0" height="138.0" as="geometry" />
        </mxCell>
        <mxCell id="qwen" value="&lt;b&gt;3b. Execute with Qwen3.8-27B&lt;/b&gt;&lt;br&gt;&lt;br&gt;Comparison executor, Q8_0&lt;br&gt;Same task and starting state&lt;br&gt;Independent execution trajectory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0E9FC;strokeColor=#8256A7;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="519.5" y="376.0" width="399.0" height="138.0" as="geometry" />
        </mxCell>
        <mxCell id="judge" value="&lt;b&gt;4. Judge the saved trajectories and review outcomes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Qwen3.8-max judges anonymised A/B traces in the expanded collection&lt;br&gt;Check completion, facts, grounding, tool/state handling and constraints&lt;br&gt;Compare with the reference outcome and source evidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF0DA;strokeColor=#C28832;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="80.0" y="572.5" width="840" height="141.0" as="geometry" />
        </mxCell>
        <mxCell id="pass" value="&lt;b&gt;5a. Reviewed local success&lt;/b&gt;&lt;br&gt;&lt;br&gt;LOCAL: task completed reliably" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E4F3DF;strokeColor=#4C8B42;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="81.5" y="770.5" width="399.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="&lt;b&gt;5b. Reviewed local failure&lt;/b&gt;&lt;br&gt;&lt;br&gt;ESCALATE: the local attempt was unreliable" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FBE5E4;strokeColor=#B9615B;strokeWidth=1.4;fontColor=#263238;fontFamily=Arial;fontSize=17;spacing=12;" vertex="1" parent="1">
