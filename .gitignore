# ──────────────────────────────────────────────
# Project-specific private documents (not for commits)
# ──────────────────────────────────────────────
# Blueprint specs, the thesis, and the session journal are local-only.
/backend_spec.md
/frontend_spec.md
/EdgeDispatch_Thesis_A.md
/memory.md
*.pdf

# ──────────────────────────────────────────────
# Python (backend)
# ──────────────────────────────────────────────
# Virtual environments
.venv/
venv/
env/

# Bytecode / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/

# Type check stubs
.pytest_cache/
*.pytest_cache

# ──────────────────────────────────────────────
# uv
# ──────────────────────────────────────────────
# uv.lock IS committed (reproducible builds); keep it.
# .python-version is generated by uv — ignore it.
.python-version

# ──────────────────────────────────────────────
# Node / Frontend (root-level catch-all; frontend/.gitignore also exists)
# ──────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ──────────────────────────────────────────────
# Local model weights (llama.cpp) — large, downloadable
# Anchored to root so it does NOT match server/models/ (Pydantic schemas).
# ──────────────────────────────────────────────
/models/
*.gguf

# ──────────────────────────────────────────────
# Environment / secrets
# ──────────────────────────────────────────────
.env
.env.*
!.env.example

# ──────────────────────────────────────────────
# Observability local data
# ──────────────────────────────────────────────
.phoenix/

# ──────────────────────────────────────────────
# OS files
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────
# Editor / IDE
# ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.sw?
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ──────────────────────────────────────────────
# Jupyter (if any notebooks are added later)
# ──────────────────────────────────────────────
.ipynb_checkpoints/
